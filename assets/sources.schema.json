{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tvapp.local/schema/tvapp.source.v1.json",
  "title": "tvapp.source.v1 / v1.1",
  "description": "安卓 TV 影视客户端可导入的播放源配置：MacCMS 站源 / m3u 直播源 / 单文件订阅（bundle）。v1.1 新增字段全部可选，v1 配置继续有效。",
  "type": "object",
  "required": ["schema", "kind", "id", "name"],
  "properties": {
    "schema": {
      "enum": ["tvapp.source.v1", "tvapp.source.v1.1"],
      "description": "协议版本闸门：v1（基线）与 v1.1（增量字段，向后兼容）"
    },
    "kind": { "enum": ["maccms", "m3u", "bundle"] },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
      "description": "稳定主键，小写字母/数字开头，长度 2..64"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "enabled": { "type": "boolean", "default": true },
    "priority": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 100 },
    "note": { "type": "string", "maxLength": 200 },
    "headers": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^(User-Agent|Referer|Origin|Cookie|Authorization|Accept|Accept-Language|X-[A-Za-z0-9-]+)$"
      },
      "additionalProperties": { "type": "string", "maxLength": 512, "pattern": "^[^\\r\\n]*$" }
    },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 15000, "default": 6000 },
    "maxConcurrent": { "type": "integer", "minimum": 1, "maximum": 4, "default": 2 },

    "epgUrls": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "description": "XMLTV 节目单地址（支持 .xml/.xml.gz）；失败不影响源使用",
      "items": { "type": "string", "maxLength": 512, "pattern": "^https?://" }
    },
    "adBlock": {
      "type": "object",
      "description": "源级广告拦截规则，供 OkHttp 拦截器使用",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "domains": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "description": "域名黑名单：精确域或以 *. 开头的通配域",
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          }
        },
        "urlKeywords": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "description": "URL 片段关键字（path+query，大小写不敏感）",
          "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^\\S(.*\\S)?$" }
        }
      },
      "additionalProperties": false
    },
    "skipIntroSeconds": { "type": "integer", "minimum": 0, "maximum": 600, "default": 0 },
    "skipIntroCue": { "type": "boolean", "default": false },
    "maxQuality": { "enum": ["auto", "1080p", "720p", "480p"], "default": "auto" },
    "preferredCodec": { "enum": ["h264", "hevc", "auto"], "default": "auto" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "maccms" } }, "required": ["kind"] },
      "then": {
        "required": ["baseUrl"],
        "properties": {
          "baseUrl": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^https?://",
            "description": "API 根地址，禁止自动增删结尾斜杠"
          },
          "flavor": { "enum": ["macjson", "maccms"], "default": "macjson" },
          "apiPathMode": { "enum": ["query", "path"], "default": "query" },
          "fallbackBaseUrls": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "maxLength": 512, "pattern": "^https?://" }
          },
          "pageSize": { "type": "integer", "minimum": 10, "maximum": 50, "default": 20 },
          "categories": {
            "type": "object",
            "propertyNames": {
              "enum": ["MOVIE", "TV", "ANIME", "VARIETY", "SHORT", "SPORTS", "OTHER"]
            },
            "additionalProperties": {
              "type": "array",
              "maxItems": 10,
              "items": { "type": "integer", "minimum": 1 }
            }
          },
          "classTtlMin": { "type": "integer", "minimum": 30, "maximum": 10080, "default": 1440 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "m3u" } }, "required": ["kind"] },
      "then": {
        "oneOf": [
          { "required": ["url"] },
          { "required": ["inline"] }
        ],
        "properties": {
          "url": { "type": "string", "maxLength": 512, "pattern": "^https?://" },
          "inline": { "type": "string", "maxLength": 524288 },
          "refreshIntervalMin": { "type": "integer", "minimum": 0, "maximum": 10080, "default": 360 },
          "maxBytes": { "type": "integer", "minimum": 65536, "maximum": 8388608, "default": 2097152 },
          "filters": {
            "type": "object",
            "properties": {
              "includeGroups": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 40 } },
              "excludeGroups": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 40 } },
              "excludeNameRegex": { "type": "string", "maxLength": 128 }
            },
            "additionalProperties": false
          },
          "dedupe": {
            "type": "object",
            "properties": {
              "byTvgId": { "type": "boolean", "default": true },
              "byName": { "type": "boolean", "default": true },
              "mergeUrls": { "type": "boolean", "default": true }
            },
            "additionalProperties": false
          },
          "channels": {
            "type": "array",
            "maxItems": 5000,
            "description": "v1.1：手工频道定义/覆盖（与解析出的 m3u 频道按同一去重键合并）",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 60 },
                "url": { "type": "string", "maxLength": 2048, "pattern": "^https?://" },
                "urls": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": { "type": "string", "maxLength": 2048, "pattern": "^https?://" }
                },
                "group": { "type": "string", "minLength": 1, "maxLength": 20 },
                "logo": { "type": "string", "maxLength": 512, "pattern": "^https?://" },
                "tvgId": { "type": "string", "minLength": 1, "maxLength": 128 },
                "epgId": { "type": "string", "minLength": 1, "maxLength": 128 },
                "desc": { "type": "string", "maxLength": 200 }
              },
              "oneOf": [
                { "required": ["url"] },
                { "required": ["urls"] }
              ],
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "bundle" } }, "required": ["kind"] },
      "then": {
        "required": ["sources"],
        "properties": {
          "version": { "type": "integer", "minimum": 0 },
          "updatedAt": { "type": "string", "format": "date-time" },
          "refreshIntervalHour": { "type": "integer", "minimum": 0, "maximum": 168, "default": 24 },
          "signature": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "merge": { "enum": ["byId", "replace"], "default": "byId" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": { "$ref": "#" }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
